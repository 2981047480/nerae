import { SecureVaultResult, VersionedSecureVaultResult } from './interface.uts'

function unsupported(): SecureVaultResult {
  return { ok: false, errorCode: 'unsupported_platform', found: false, value: '' }
}

export function readAuthenticationState(): SecureVaultResult { return unsupported() }
export function writeAuthenticationState(_value: string): SecureVaultResult { return unsupported() }
export function clearAuthenticationState(): SecureVaultResult { return unsupported() }

export function readDeviceIdentityRegistry(): SecureVaultResult { return unsupported() }
export function compareAndSetDeviceIdentityRegistry(_expectedFound: boolean, _expectedValue: string, _value: string): SecureVaultResult { return unsupported() }

export function readTrainingOperationJournal(): SecureVaultResult { return unsupported() }
export function compareAndSetTrainingOperationJournal(_expectedFound: boolean, _expectedValue: string, _value: string): SecureVaultResult { return unsupported() }

function unsupportedVersioned(): VersionedSecureVaultResult {
  return { ok: false, errorCode: 'unsupported_platform', found: false, value: '', revision: '' }
}
export function readVersionedTrainingOperationJournal(): VersionedSecureVaultResult { return unsupportedVersioned() }
export function compareAndSetVersionedTrainingOperationJournal(_expectedRevision: string, _expectedFound: boolean, _expectedValue: string, _newFound: boolean, _newValue: string): VersionedSecureVaultResult { return unsupportedVersioned() }
