import { SecureVaultResult, VersionedSecureVaultResult } from '../interface.uts'

export function trainingDraftStorageCapability(): string { return 'android-legacy-v1' }

function failure(errorCode: string): SecureVaultResult {
	const parsed = JSON.parseObject<SecureVaultResult>(
		'{"ok":false,"errorCode":"' + errorCode + '","found":false,"value":""}'
	)
	if (parsed != null) return parsed!
	return JSON.parseObject<SecureVaultResult>(
		'{"ok":false,"errorCode":"bridge_failure","found":false,"value":""}'
	)!
}

function decode(raw: string, isRead: boolean): SecureVaultResult {
	try {
		const parsed = JSON.parseObject<SecureVaultResult>(raw)
		if (parsed == null) return failure('bridge_failure')
		const result = parsed!
		if (!result.ok) {
			if (result.errorCode != 'invalid_state' && result.errorCode != 'unavailable' && result.errorCode != 'conflict') return failure('bridge_failure')
			return failure(result.errorCode)
		}
		if (result.errorCode.length != 0) return failure('bridge_failure')
		if (!isRead && (result.found || result.value.length != 0)) return failure('bridge_failure')
		if (isRead && (result.found == (result.value.length == 0))) return failure('bridge_failure')
		return result
	} catch (_error) {
		return failure('bridge_failure')
	}
}

export function readAuthenticationState(): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.readAuthenticationState(UTSAndroid.getAppContext()), true)
}

export function writeAuthenticationState(value: string): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.writeAuthenticationState(UTSAndroid.getAppContext(), value), false)
}

export function clearAuthenticationState(): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.clearAuthenticationState(UTSAndroid.getAppContext()), false)
}

export function readDeviceIdentityRegistry(): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.readDeviceIdentityRegistry(UTSAndroid.getAppContext()), true)
}

export function compareAndSetDeviceIdentityRegistry(expectedFound: boolean, expectedValue: string, value: string): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.compareAndSetDeviceIdentityRegistry(UTSAndroid.getAppContext(), expectedFound, expectedValue, value), false)
}

export function readTrainingDraft(key: string): SecureVaultResult {
	return decode(NeraeAndroidTrainingDraftBridge.readTrainingDraft(UTSAndroid.getAppContext(), key), true)
}
export function discoverTrainingDrafts(subjectId: string, cursor: string): SecureVaultResult {
	return decode(NeraeAndroidTrainingDraftBridge.discoverTrainingDrafts(UTSAndroid.getAppContext(), subjectId, cursor), true)
}
export function createTrainingDraft(key: string, value: string): SecureVaultResult {
	return decode(NeraeAndroidTrainingDraftBridge.createTrainingDraft(UTSAndroid.getAppContext(), key, value), false)
}
export function writeTrainingDraft(key: string, value: string): SecureVaultResult {
	return decode(NeraeAndroidTrainingDraftBridge.writeTrainingDraft(UTSAndroid.getAppContext(), key, value), false)
}

export function readTrainingOperationJournal(): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.readTrainingOperationJournal(UTSAndroid.getAppContext()), true)
}

export function compareAndSetTrainingOperationJournal(expectedFound: boolean, expectedValue: string, value: string): SecureVaultResult {
	return decode(NeraeAndroidSecureVaultBridge.compareAndSetTrainingOperationJournal(UTSAndroid.getAppContext(), expectedFound, expectedValue, value), false)
}

function versionedFailure(errorCode: string): VersionedSecureVaultResult {
	return { ok: false, errorCode: errorCode, found: false, value: '', revision: '' }
}
function validRevision(revision: string): boolean {
	return /^(0|[1-9][0-9]{0,18})$/.test(revision) &&
		(revision.length < 19 || revision <= '9223372036854775807')
}

// Revision zero is also valid for an unchanged legacy draft.
function decodeVersionedDraft(raw: string, isRead: boolean): VersionedSecureVaultResult {
	try {
		const parsed = JSON.parseObject<VersionedSecureVaultResult>(raw)
		if (parsed == null) return versionedFailure('bridge_failure')
		const result = parsed!
		if (!result.ok) {
			if (result.errorCode != 'invalid_state' && result.errorCode != 'unavailable' && result.errorCode != 'conflict') return versionedFailure('bridge_failure')
			return versionedFailure(result.errorCode)
		}
		if (result.errorCode.length != 0 || !validRevision(result.revision)) return versionedFailure('bridge_failure')
		if (isRead && (result.found == (result.value.length == 0) || (!result.found && result.revision != '0'))) return versionedFailure('bridge_failure')
		if (!isRead && (result.found || result.value.length != 0 || result.revision == '0')) return versionedFailure('bridge_failure')
		return result
	} catch (_error) {
		return versionedFailure('bridge_failure')
	}
}

export function readVersionedTrainingDraft(key: string): VersionedSecureVaultResult {
	try {
		return decodeVersionedDraft(NeraeAndroidTrainingDraftBridge.readVersionedTrainingDraft(UTSAndroid.getAppContext(), key), true)
	} catch (_error) { return versionedFailure('bridge_failure') }
}

export function compareAndSetVersionedTrainingDraft(key: string, expectedRevision: string, expectedFound: boolean, expectedValue: string, value: string): VersionedSecureVaultResult {
	if (!validRevision(expectedRevision) || expectedFound == (expectedValue.length == 0) ||
		(!expectedFound && expectedRevision != '0') || value.length == 0) return versionedFailure('invalid_state')
	try {
		return decodeVersionedDraft(NeraeAndroidTrainingDraftBridge.compareAndSetVersionedTrainingDraft(UTSAndroid.getAppContext(), key, expectedRevision, expectedFound, expectedValue, value), false)
	} catch (_error) { return versionedFailure('bridge_failure') }
}

function decodeVersioned(raw: string, isRead: boolean): VersionedSecureVaultResult {
	try {
		const parsed = JSON.parseObject<VersionedSecureVaultResult>(raw)
		if (parsed == null) return versionedFailure('bridge_failure')
		const result = parsed!
		if (!result.ok) {
			if (result.errorCode != 'invalid_state' && result.errorCode != 'unavailable' && result.errorCode != 'conflict') return versionedFailure('bridge_failure')
			return versionedFailure(result.errorCode)
		}
		if (result.errorCode.length != 0 || !validRevision(result.revision)) return versionedFailure('bridge_failure')
		if (!isRead && (result.found || result.value.length != 0 || result.revision == '0')) return versionedFailure('bridge_failure')
		if (isRead && (result.found == (result.value.length == 0) || (result.found && result.revision == '0'))) return versionedFailure('bridge_failure')
		return result
	} catch (_error) {
		return versionedFailure('bridge_failure')
	}
}

export function readVersionedTrainingOperationJournal(): VersionedSecureVaultResult {
	return decodeVersioned(NeraeAndroidSecureVaultBridge.readVersionedTrainingOperationJournal(UTSAndroid.getAppContext()), true)
}
export function compareAndSetVersionedTrainingOperationJournal(expectedRevision: string, expectedFound: boolean, expectedValue: string, newFound: boolean, newValue: string): VersionedSecureVaultResult {
	if (!validRevision(expectedRevision) || expectedFound == (expectedValue.length == 0) ||
		(expectedFound && expectedRevision == '0') || newFound == (newValue.length == 0)) return versionedFailure('invalid_state')
	return decodeVersioned(NeraeAndroidSecureVaultBridge.compareAndSetVersionedTrainingOperationJournal(UTSAndroid.getAppContext(), expectedRevision, expectedFound, expectedValue, newFound, newValue), false)
}

export function claimTrainingOperationDispatch(expectedRevision: string, expectedValue: string, operationKey: string, nextValue: string): VersionedSecureVaultResult {
	if (!validRevision(expectedRevision) || expectedRevision == '0' || expectedValue.length == 0 ||
		operationKey.length == 0 || nextValue.length == 0) return versionedFailure('invalid_state')
	try {
		return decodeVersioned(NeraeAndroidSecureVaultBridge.claimTrainingOperationDispatch(UTSAndroid.getAppContext(), expectedRevision, expectedValue, operationKey, nextValue), false)
	} catch (_error) {
		return versionedFailure('bridge_failure')
	}
}
