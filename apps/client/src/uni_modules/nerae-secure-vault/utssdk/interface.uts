/** Sensitive values must never be logged, placed in URLs, or stored elsewhere. */
export type SecureVaultResult = {
  ok: boolean
  errorCode: string
  found: boolean
  value: string
}

export type ReadAuthenticationState = () => SecureVaultResult
export type WriteAuthenticationState = (value: string) => SecureVaultResult
export type ClearAuthenticationState = () => SecureVaultResult

/** Device identity registry state is stored independently from the login session. */
export type ReadDeviceIdentityRegistry = () => SecureVaultResult
/**
 * Compare-and-set the complete registry value. When expectedFound is false,
 * expectedValue must be empty and the registry must be absent. When true, the
 * exact expectedValue must still be stored. Conflicts return no registry data.
 */
export type CompareAndSetDeviceIdentityRegistry = (expectedFound: boolean, expectedValue: string, value: string) => SecureVaultResult

/** One independently protected draft per key; create never overwrites. */
export type ReadTrainingDraft = (key: string) => SecureVaultResult
export type DiscoverTrainingDrafts = (subjectId: string, cursor: string) => SecureVaultResult
export type CreateTrainingDraft = (key: string, value: string) => SecureVaultResult
export type WriteTrainingDraft = (key: string, value: string) => SecureVaultResult

/** One bounded JSON journal for pending training operations; maximum 64 KiB UTF-8. */
export type ReadTrainingOperationJournal = () => SecureVaultResult
/** Atomic only within one App process. No unconditional overwrite or clear API is exposed. */
export type CompareAndSetTrainingOperationJournal = (expectedFound: boolean, expectedValue: string, value: string) => SecureVaultResult

/** Native-owned slot revision; writes and logical deletion advance it atomically. */
export type VersionedSecureVaultResult = {
  ok: boolean
  errorCode: string
  found: boolean
  value: string
  revision: string
}
/** Legacy drafts may be found at revision 0; a successful mutation advances it. */
export type ReadVersionedTrainingDraft = (key: string) => VersionedSecureVaultResult
export type CompareAndSetVersionedTrainingDraft = (
  key: string, expectedRevision: string, expectedFound: boolean, expectedValue: string, value: string
) => VersionedSecureVaultResult
export type ReadVersionedTrainingOperationJournal = () => VersionedSecureVaultResult
export type CompareAndSetVersionedTrainingOperationJournal = (
  expectedRevision: string, expectedFound: boolean, expectedValue: string, newFound: boolean, newValue: string
) => VersionedSecureVaultResult
/** Atomically records a first-send marker and the matching journal transition. */
export type ClaimTrainingOperationDispatch = (
  expectedRevision: string, expectedValue: string, operationKey: string, nextValue: string
) => VersionedSecureVaultResult
