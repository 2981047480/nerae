  "cards": [
    {
      "dot": "violet",
      "title": "典型用法",
      "items": [
        "一句话描述系统/流程 → 可交互 HTML 图。",
        "让 Agent 读仓库 → 带源码证据的运行时架构图。",
        "把一次回答做成一页：结论先行 + 面板 + 原生图 + 引用。",
        "不满意就继续对话改 JSON，结构未动的部分保持稳定。"
      ]
    },
    {
      "dot": "amber",
      "title": "明确不做",
      "items": [
        "通用自动布局（手放坐标即产品，实验 FAILED）。",
        "Mermaid 解析器 / WYSIWYG 编辑 / 托管分享 / 移动端 / 专用 PDF 按钮。",
        "不承诺图等于线上真实运行状态。"
      ]
    },
    {
      "dot": "emerald",
      "title": "质量主张",
      "items": [
        "showcase = 零 warning；校验通过 ≠ 视觉正确，回执区分两者。",
        "benchmark 公开“普通模型首稿可用 10/15”，不吹 uplift。",
        "失败给 subject + evidence + supportedFixes，而不是重试。"
      ]
    }
