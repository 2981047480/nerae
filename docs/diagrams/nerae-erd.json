      "id": "ai_student",
      "from": "ai_run",
      "to": "user",
      "label": "AI 触发",
      "fromCardinality": "many",
      "toCardinality": "one",
      "fromOptional": true
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "A 方案的关系口径",
      "items": [
        "service_relation 是交付开关：平台外成交后，由学员与教练双方确认后才生效。",
        "平台内不收款、不代收、不分账；appointment 只记录意向与自报成交状态。",
        "data_grant 控制教练可见范围（档案/训练/身体/伤病），可撤回，按 version 生效。"
      ]
    },
    {
      "dot": "amber",
      "title": "关键唯一键与去重",
      "items": [
        "user.openid、appointment.appointment_no 为业务唯一键。",
        "workout_session.client_event_id 用于客户端重复上报去重。",
        "plan.version 支持计划改动留痕；ai_run 记录模型、tokens、成本与安全标记。"
      ]
    },
    {
      "dot": "emerald",
      "title": "图怎么读",
      "items": [
        "从左到右四列：账号档案 → 服务交易 → 计划内容 → 训练与运营。",
        "实线为必选关系；虚线为可空/可选（如计划可改编自模板、可挂服务关系）。",
        "表内 key 标记：pk 主键、fk 外键、uk 唯一键；外键在 references 中给出父列。"
      ]
    }
  ]
