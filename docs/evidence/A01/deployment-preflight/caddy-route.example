# Candidate fragment only. Merge into the currently deployed IP/domain site
# block after reviewing route order and validating the complete live Caddyfile.
# Keep the existing site and certificate configuration intact.
handle_path /nerae-api-v1/* {
	@health path /health/*
	respond @health 404
	# Replace the placeholder only after reserving/checking a free loopback port.
	reverse_proxy 127.0.0.1:API_LOOPBACK_PORT {
		header_up X-Nerae-Proxy-Credential {$NERAE_PROXY_CREDENTIAL}
		header_up X-Nerae-Trusted-Source-IP {remote_host}
	}
}
