# Candidate fragment only. Merge into the currently deployed IP/domain site
# block after reviewing route order and validating the complete live Caddyfile.
# This public gateway must not contain or have read access to the proxy secret.
handle_path /nerae-api-v1/* {
	@health path /health/*
	respond @health 404
	# A separate, restricted local Caddy owns this socket and adds the secret.
	reverse_proxy unix//run/nerae-proxy/proxy.sock {
		header_up X-Nerae-Trusted-Source-IP {remote_host}
		header_up -X-Nerae-Proxy-Credential
	}
}
